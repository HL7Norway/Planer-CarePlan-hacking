@startuml
title CarePlan sonemodell uten extension
footer Pasientens planer: sone via CarePlan.addresses -> Condition

class PlanerHackingPatient {
  +identifier
  +name
}

class PlanerHackingCarePlan {
  +title
  +description (personlige mål)
  +addresses[1..*]
}

class PlanerHackingZoneCondition {
  +clinicalStatus: active
  +severity: green|yellow|red
  +code.text: observasjonsområde
  +note.text: anbefalt tiltak
}

PlanerHackingCarePlan --> PlanerHackingPatient : subject
PlanerHackingCarePlan --> "1..*" PlanerHackingZoneCondition : addresses
PlanerHackingZoneCondition --> PlanerHackingPatient : subject

note right of PlanerHackingZoneCondition
Eksempel:
- code.text = "Peak flow 50-80%"
- severity.coding[zoneSystem].code = yellow
- note.text = "Øk medikamentdose og kontakt fastlege"
end note

@enduml
